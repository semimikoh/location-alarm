{
  "expo": {
    "name": "위치 알람",
    "slug": "location-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "location-alarm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.semimikoh.locationalarm"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F3F0",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "package": "com.semimikoh.locationalarm"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "IBM Plex Sans KR",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/IBMPlexSansKR-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSansKR-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSansKR-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSansKR-Bold.otf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/IBMPlexSansKR-Regular.otf",
              "./assets/fonts/IBMPlexSansKR-Medium.otf",
              "./assets/fonts/IBMPlexSansKR-SemiBold.otf",
              "./assets/fonts/IBMPlexSansKR-Bold.otf"
            ]
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
