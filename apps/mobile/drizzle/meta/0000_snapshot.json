        "alarms_vibrate_boolean": {
          "name": "alarms_vibrate_boolean",
          "value": "\"alarms\".\"vibrate\" IN (0, 1)"
        },
        "alarms_repeat_schedule": {
          "name": "alarms_repeat_schedule",
          "value": "(\"alarms\".\"repeat\" = 1 AND \"alarms\".\"repeat_days\" <> '[]' AND \"alarms\".\"window_start\" GLOB '[0-2][0-9]:[0-5][0-9]' AND CAST(substr(\"alarms\".\"window_start\", 1, 2) AS INTEGER) <= 23 AND \"alarms\".\"window_end\" GLOB '[0-2][0-9]:[0-5][0-9]' AND CAST(substr(\"alarms\".\"window_end\", 1, 2) AS INTEGER) <= 23 AND (CAST(substr(\"alarms\".\"window_start\", 1, 2) AS INTEGER) * 60 + CAST(substr(\"alarms\".\"window_start\", 4, 2) AS INTEGER)) < (CAST(substr(\"alarms\".\"window_end\", 1, 2) AS INTEGER) * 60 + CAST(substr(\"alarms\".\"window_end\", 4, 2) AS INTEGER))) OR (\"alarms\".\"repeat\" = 0 AND \"alarms\".\"repeat_days\" = '[]' AND \"alarms\".\"window_start\" IS NULL AND \"alarms\".\"window_end\" IS NULL)"
        }
      }
